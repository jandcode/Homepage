{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/crm/:path*",
      "destination": "/api/crm/[...path]"
    },
    {
      "source": "/api/portal/:path*",
      "destination": "/api/portal/[...path]"
    }
  ]
}
